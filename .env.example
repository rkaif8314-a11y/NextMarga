# Supabase (client-safe values; add these in Vercel Environment Variables)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase server-side auth lookup (keep the anon key server-only when using this path)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Gemini CareerAI (server-side only; NEVER expose these as VITE_*)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Optional application URL
APP_URL="https://nextmarga.vercel.app"
